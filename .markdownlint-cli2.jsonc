{
  "config": {
    "default": true,
    // Reference tables and long URLs make line length meaningless here
    "MD013": false,
    // Inline HTML the pages use: area anchors, line breaks in table cells,
    // collapsed secondary material, the README's centered banner and the
    // tools' components (one tag per .vue file in docs/.vitepress/theme/tools/)
    // and the home page's sections (docs/.vitepress/theme/home/)
    "MD033": {
      "allowed_elements": [
        "a", "br", "details", "summary", "p", "img", "script",
        "ToolCards", "DamageStrings", "ItemSearch", "TerritoryCalculator", "HousingCalculator",
        "LevelingAlignment", "LevelingGear",
        "HomeHero", "HomeEntries", "HomeGettingIn", "HomeSpeedwalk", "HomeStats", "HomeNote"
      ]
    },
    // Dash bullets everywhere
    "MD004": { "style": "dash" },
    // Every table row has the header's column count
    "MD056": true,
    // Blank lines around tables
    "MD058": true,
    // Table pipes with one space each side, no alignment padding
    "MD060": { "style": "compact" }
  },
  "globs": ["README.md", "CONTRIBUTING.md", "docs/**/*.md"],
  "ignores": ["**/node_modules/**", "docs/.vitepress/**"]
}
